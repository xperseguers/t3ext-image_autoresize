      <trans-unit id="message.imageTransparent">
        <source>Image %s has not been resized because transparency has been detected.</source>
        <target state="translated">Bildet %s er ikke endret i størrelse fordi det ble oppdaget gjennomsiktighet.</target>
      </trans-unit>
      <trans-unit id="message.imageAnimated">
        <source>Image %s has not been resized because it is an animated GIF.</source>
        <target state="translated">Bildet %s er ikke endret i størrelse fordi det er en animert GIF.</target>
      </trans-unit>
      <trans-unit id="message.imageResized">
        <source>Image %s has been automatically resized to %s×%s pixels.</source>
        <target state="translated">Bildet %s er automatisk endret til %s×%s piksler.</target>
      </trans-unit>
      <trans-unit id="message.imageResizedAndRenamed">
        <source>Image %s has been automatically resized to %s×%s pixels and has been renamed as %s.</source>
        <target state="translated">Bildet %s er automatisk endret til %s×%s piksler og har fått nytt navn: %s.</target>
      </trans-unit>
      <trans-unit id="message.imageNotWritable">
        <source>Image %s cannot be resized because file is not writable.</source>
        <target state="translated">Bildet %s kan ikke endres i størrelse fordi filen ikke er skrivbar.</target>
      </trans-unit>
      <trans-unit id="message.cannotResize">
        <source>Image could not get resized since ImageMagick or GraphicsMagick seems to be configured incorrectly.</source>
        <target state="translated">Bildestørrelsen kunne ikke endres fordi ImageMagick eller GraphicsMagick ser ut til å være feil konfigurert.</target>
      </trans-unit>
