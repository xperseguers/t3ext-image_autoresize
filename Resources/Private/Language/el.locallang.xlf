      </trans-unit>
      <trans-unit id="message.imageNotWritable" approved="yes">
        <source>Image %s cannot be resized because file is not writable.</source>
        <target state="final">Δεν είναι δυνατή η αλλαγή μεγέθους της εικόνας %s επειδή το αρχείο δεν είναι εγγράψιμο.</target>
      </trans-unit>
      <trans-unit id="message.cannotResize" approved="yes">
