      <trans-unit id="message.imageTransparent" approved="yes">
        <source>Image %s has not been resized because transparency has been detected.</source>
        <target state="final">Η εικόνα %s δεν άλλαξε μέγεθος επειδή εντοπίστηκε διαφάνεια.</target>
      </trans-unit>
      <trans-unit id="message.imageAnimated" approved="yes">
        <source>Image %s has not been resized because it is an animated GIF.</source>
        <target state="final">Η εικόνα %s δεν άλλαξε μέγεθος επειδή είναι κινούμενο GIF.</target>
      </trans-unit>
      <trans-unit id="message.imageResized" approved="yes">
        <source>Image %s has been automatically resized to %s×%s pixels.</source>
        <target state="final">Η εικόνα %s άλλαξε αυτόματα μέγεθος σε %s×%s pixel.</target>
      </trans-unit>
      <trans-unit id="message.imageResizedAndRenamed" approved="yes">
        <source>Image %s has been automatically resized to %s×%s pixels and has been renamed as %s.</source>
